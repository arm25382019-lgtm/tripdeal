VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public tracking/deep-link URL after AirAsia Partnerize approval.
# This is not a secret; it is used in the browser for the final airline handoff.
VITE_AIRASIA_AFFILIATE_URL=

# Server-only. Never prefix these with VITE_ and never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Travelpayouts is used only for reference fares / featured-deal discovery.
TRAVELPAYOUTS_TOKEN=

# Amadeus Flight Offers Search powers live full-service carrier search.
# Use AMADEUS_ENV=test while developing, then production for real-time production data.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test
